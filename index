<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Kritivan D2C Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  /* Kritivan brand system */
  --sage:#5F7F73;          /* deep sage — primary */
  --sage-deep:#4c6a5f;
  --lilac:#C8A2C8;         /* dusty lilac — accent */
  --lilac-deep:#a87aa8;
  --terra:#C97C5D;         /* muted terracotta */
  --terra-deep:#b0644a;
  --charcoal:#2F2F2F;
  /* mapped onto existing variable names used across the app */
  --ink:#2F2F2F;           /* charcoal text / headings */
  --ink-soft:#5C6B64;      /* muted foreground */
  --madder:#C97C5D;        /* terracotta accent */
  --madder-deep:#b0644a;
  --gold:#C8A2C8;          /* repurposed: dusty-lilac accent */
  --leaf:#5F7F73;          /* sage */
  --cream:#F5F2EC;         /* warm off-white — background */
  --cream-2:#E8E0D5;       /* soft beige — secondary surface */
  --paper:#FFFFFF;         /* card */
  --line:#DED4C5;          /* border */
  --ok:#5F7F73;            /* positive = sage */
  --warn:#C97C5D;
  --shadow:0 1px 2px rgba(47,47,47,.05),0 8px 24px rgba(47,47,47,.07);
  --radius:12px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:
    radial-gradient(1200px 600px at 110% -10%, rgba(200,162,200,.10), transparent 55%),
    radial-gradient(900px 500px at -10% 110%, rgba(93,115,85,.10), transparent 55%),
    var(--cream);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
}
/* faint woven texture */
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;z-index:0;
  background-image:linear-gradient(90deg,#000 1px,transparent 1px),linear-gradient(#000 1px,transparent 1px);
  background-size:7px 7px;
}
.app{position:relative;z-index:1;max-width:1080px;margin:0 auto;padding:0 16px 120px}

/* ===== SaaS app shell ===== */
.shell{position:relative;z-index:1;display:flex;min-height:100vh}
.sidebar{width:250px;flex:0 0 250px;background:var(--paper);color:var(--charcoal);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;border-right:1px solid var(--line)}
.side-brand{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:20px 18px 16px;border-bottom:1px solid var(--line)}
.side-brand .mark{width:auto;height:auto;border-radius:0;flex:none;background:none;box-shadow:none;display:block;overflow:visible;position:static}
.side-brand .mark img{width:152px;height:auto;display:block}
.side-brand h1{display:none}
.side-brand .sub{font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-soft);margin-top:0;padding-left:3px;font-weight:600}
.side-nav{display:flex;flex-direction:column;gap:3px;padding:12px 12px;flex:1;overflow-y:auto}
.side-nav button{display:flex;align-items:center;gap:11px;width:100%;text-align:left;border:0;background:transparent;color:var(--ink-soft);font-family:inherit;font-weight:600;font-size:14px;padding:11px 13px;border-radius:10px;cursor:pointer;transition:.15s}
.side-nav button .ni{font-size:15px;width:20px;text-align:center;flex:0 0 20px}
.side-nav button:hover{background:var(--cream-2);color:var(--charcoal)}
.side-nav button.active{background:rgba(95,127,115,.12);color:var(--sage-deep);box-shadow:inset 3px 0 0 var(--sage)}
.nav-div{font-size:9.5px;letter-spacing:.14em;color:var(--ink-soft);font-weight:700;padding:16px 13px 6px;opacity:.75}
.side-foot{padding:13px 14px 16px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
.side-cta{width:100%;justify-content:center;display:flex;align-items:center;gap:7px}
.side-foot .saved-pill{justify-content:center}

.main{flex:1;min-width:0;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:14px;padding:13px 26px;background:rgba(245,242,236,.85);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.topbar .page-title{font-family:'Playfair Display';font-weight:600;font-size:20px;margin:0;flex:1;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topbar-actions{display:flex;align-items:center;gap:12px}
.hamb{display:none;border:1px solid var(--line);background:var(--paper);width:38px;height:38px;border-radius:10px;font-size:17px;cursor:pointer;color:var(--ink);flex:0 0 38px}
.sync-dot{width:9px;height:9px;border-radius:50%;background:var(--ink-soft);box-shadow:0 0 0 3px rgba(47,47,47,.08)}
.sync-dot.on{background:var(--sage);box-shadow:0 0 0 3px rgba(95,127,115,.2)}
.content{padding:24px 26px 100px;max-width:1160px;width:100%}
.content .title{margin-top:0}
.backdrop{display:none;position:fixed;inset:0;background:rgba(47,47,47,.42);backdrop-filter:blur(2px);z-index:39}

@media(max-width:960px){
  .sidebar{position:fixed;top:0;left:0;z-index:40;transform:translateX(-100%);transition:transform .28s cubic-bezier(.19,1,.22,1);box-shadow:0 0 44px rgba(0,0,0,.34)}
  .sidebar.open{transform:translateX(0)}
  .backdrop.show{display:block}
  .hamb{display:grid;place-items:center}
  .topbar{padding:11px 15px}
  .content{padding:18px 15px 110px}
  .topbar .page-title{font-size:17px}
}

/* Header */
header.brand{display:flex;align-items:center;justify-content:space-between;padding:22px 4px 14px}
.logo{display:flex;align-items:center;gap:12px}
.logo .mark{
  width:42px;height:42px;border-radius:12px;flex:0 0 42px;
  background:linear-gradient(135deg,var(--ink),#33456a);
  display:grid;place-items:center;color:var(--cream);box-shadow:var(--shadow);
  position:relative;overflow:hidden;
}
.logo .mark::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(45deg,rgba(255,255,255,.08) 0 3px,transparent 3px 7px)}
.logo .mark span{font-family:'Playfair Display';font-weight:600;font-size:22px;line-height:1}
.logo h1{font-family:'Playfair Display';font-weight:600;font-size:21px;margin:0;letter-spacing:-.01em}
.logo .sub{font-size:11.5px;color:var(--ink-soft);letter-spacing:.14em;text-transform:uppercase;margin-top:1px}
.saved-pill{font-size:11px;color:var(--leaf);display:flex;align-items:center;gap:6px;background:rgba(93,115,85,.12);padding:6px 11px;border-radius:999px;font-weight:600}
.saved-pill .dot{width:7px;height:7px;border-radius:50%;background:var(--leaf)}

/* Tabs */
nav.tabs{display:flex;gap:6px;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:5px;box-shadow:var(--shadow);overflow-x:auto;margin-bottom:20px}
nav.tabs button{flex:1;min-width:max-content;border:0;background:transparent;font-family:inherit;font-weight:600;font-size:13.5px;color:var(--ink-soft);padding:10px 14px;border-radius:10px;cursor:pointer;white-space:nowrap;transition:.18s;display:flex;align-items:center;gap:7px;justify-content:center}
nav.tabs button.active{background:var(--ink);color:var(--cream)}
nav.tabs button:not(.active):hover{background:var(--cream-2)}

.screen{display:none;animation:fade .35s ease both}
.screen.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

h2.title{font-family:'Playfair Display';font-weight:600;font-size:26px;margin:4px 0 2px;letter-spacing:-.015em}
p.lede{color:var(--ink-soft);margin:0 0 20px;font-size:14.5px;max-width:60ch}

/* Home entry grid */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:720px){.grid{grid-template-columns:repeat(2,1fr)}}
.entry{
  background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:18px 16px;cursor:pointer;text-align:left;
  box-shadow:var(--shadow);transition:.18s;font-family:inherit;position:relative;overflow:hidden;
}
.entry:hover{transform:translateY(-3px);border-color:var(--gold)}
.entry .ico{font-size:24px;display:block;margin-bottom:12px}
.entry .lbl{font-weight:700;font-size:15px;color:var(--ink);line-height:1.2}
.entry .desc{font-size:12px;color:var(--ink-soft);margin-top:5px;line-height:1.35}
.entry::before{content:"";position:absolute;top:0;left:0;width:100%;height:3px;background:var(--accent,var(--madder));transform:scaleX(0);transform-origin:left;transition:.25s}
.entry:hover::before{transform:scaleX(1)}

/* Stat cards */
.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:22px}
@media(max-width:720px){.stat-row{grid-template-columns:repeat(2,1fr)}}
.stat{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow)}
.stat .k{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--ink-soft);font-weight:600}
.stat .v{font-family:'Playfair Display';font-size:25px;font-weight:600;margin-top:6px;letter-spacing:-.02em}
.stat .v.pos{color:var(--ok)} .stat .v.neg{color:var(--warn)}
.stat .meta{font-size:11.5px;color:var(--ink-soft);margin-top:3px}

/* Panels & tables */
.panel{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:20px;overflow:hidden}
.panel-h{padding:15px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}
.panel-h h3{font-family:'Playfair Display';font-weight:600;font-size:17px;margin:0}
.panel-h .hint{font-size:12px;color:var(--ink-soft)}
.tbl-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px;min-width:520px}
th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--ink-soft);font-weight:700;padding:11px 14px;border-bottom:1px solid var(--line);background:var(--cream)}
td{padding:11px 14px;border-bottom:1px solid var(--cream-2);vertical-align:middle}
tr:last-child td{border-bottom:0}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
.tag{display:inline-block;font-size:10.5px;font-weight:700;padding:3px 8px;border-radius:999px;letter-spacing:.03em}
.tag.bc{background:rgba(184,80,58,.14);color:var(--madder-deep)}
.tag.bs{background:rgba(93,115,85,.16);color:var(--leaf)}
.tag.dh{background:rgba(200,162,200,.22);color:var(--lilac-deep)}
.tag.off{background:rgba(47,47,47,.1);color:var(--ink)}
.bar{height:7px;border-radius:999px;background:var(--cream-2);overflow:hidden;min-width:60px}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--madder),var(--gold))}
.empty{padding:34px 18px;text-align:center;color:var(--ink-soft);font-size:13.5px}

/* Buttons */
.btn{font-family:inherit;font-weight:700;font-size:13.5px;border-radius:11px;padding:11px 18px;cursor:pointer;border:1px solid transparent;transition:.16s}
.btn.primary{background:var(--sage);color:#fff}
.btn.primary:hover{background:var(--sage-deep)}
.btn.madder{background:var(--madder);color:#fff}.btn.madder:hover{background:var(--madder-deep)}
.btn.ghost{background:transparent;border-color:var(--line);color:var(--ink)}
.btn.ghost:hover{background:var(--cream-2)}
.btn.sm{padding:8px 13px;font-size:12.5px}
.btn-row{display:flex;gap:10px;flex-wrap:wrap}

/* Modal */
.overlay{position:fixed;inset:0;background:rgba(47,47,47,.42);backdrop-filter:blur(3px);display:none;align-items:flex-end;justify-content:center;z-index:50;padding:0}
.overlay.show{display:flex;animation:fade .2s}
@media(min-width:640px){.overlay{align-items:center;padding:24px}}
.modal{background:var(--paper);width:100%;max-width:640px;max-height:92vh;border-radius:22px 22px 0 0;overflow:auto;box-shadow:0 -10px 40px rgba(47,47,47,.25);animation:slideup .3s cubic-bezier(.19,1,.22,1) both}
@media(min-width:640px){.modal{border-radius:22px}}
@keyframes slideup{from{transform:translateY(40px);opacity:.6}to{transform:none;opacity:1}}
.modal-h{position:sticky;top:0;background:var(--paper);padding:18px 20px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;z-index:2}
.modal-h h3{font-family:'Playfair Display';font-weight:600;font-size:19px;margin:0;display:flex;align-items:center;gap:9px}
.modal-h .x{border:0;background:var(--cream-2);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:18px;color:var(--ink);line-height:1}
.modal-b{padding:18px 20px 22px}
.modal-f{position:sticky;bottom:0;background:var(--paper);border-top:1px solid var(--line);padding:14px 20px;display:flex;gap:10px;justify-content:flex-end}

/* Forms */
.fg{margin-bottom:14px}
.fg label{display:block;font-size:12px;font-weight:700;color:var(--ink);margin-bottom:6px;letter-spacing:.01em}
.fg .opt{color:var(--ink-soft);font-weight:500}
input,select,textarea{width:100%;font-family:inherit;font-size:14px;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--cream);color:var(--ink);transition:.15s}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(200,162,200,.16)}
textarea{resize:vertical;min-height:64px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
@media(max-width:520px){.row2,.row3{grid-template-columns:1fr}}
.checklist{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-height:230px;overflow:auto;border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--cream)}
.chk{display:flex;align-items:center;gap:8px;font-size:13px;padding:7px 9px;border-radius:8px;cursor:pointer;background:#fff;border:1px solid var(--line)}
.chk input{width:auto;margin:0}
.chk.on{border-color:var(--gold);background:rgba(200,162,200,.1)}
.help{font-size:11.5px;color:var(--ink-soft);margin-top:5px;line-height:1.4}
.calc-pill{background:rgba(63,125,87,.12);color:var(--ok);font-weight:700;font-size:12.5px;padding:8px 12px;border-radius:10px;display:inline-block;margin-top:4px}
.sku-line-tbl{width:100%;border-collapse:collapse;font-size:13px}
.sku-line-tbl th{padding:7px;font-size:10px;background:transparent}
.sku-line-tbl td{padding:5px 4px;border:0}
.sku-line-tbl input{padding:8px 8px;font-size:13px}
.section-div{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--madder);margin:18px 0 10px;display:flex;align-items:center;gap:10px}
.section-div::after{content:"";flex:1;height:1px;background:var(--line)}

.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--ink);color:var(--cream);padding:13px 22px;border-radius:999px;font-weight:600;font-size:14px;box-shadow:0 10px 30px rgba(47,47,47,.3);z-index:99;opacity:0;transition:.3s;display:flex;align-items:center;gap:9px}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}

.del{color:var(--madder);cursor:pointer;font-weight:700;font-size:12px;background:none;border:0;padding:4px}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink-soft);margin-bottom:14px}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:11px;height:11px;border-radius:3px;display:inline-block}
.note{background:rgba(95,127,115,.09);border:1px solid rgba(95,127,115,.26);border-radius:12px;padding:13px 15px;font-size:13px;color:var(--sage-deep);margin-bottom:18px;line-height:1.5}
.split2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:820px){.split2{grid-template-columns:1fr}}
.iggrid{display:flex;align-items:flex-end;gap:8px;height:120px;padding:10px 0}
.iggrid .col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;justify-content:flex-end}
.iggrid .col .b{width:100%;max-width:34px;border-radius:6px 6px 0 0;background:linear-gradient(180deg,var(--gold),var(--madder));min-height:4px}
.iggrid .col .lab{font-size:9.5px;color:var(--ink-soft)}

/* KPI band (industry-standard metrics) */
.kpi-band{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}
@media(max-width:880px){.kpi-band{grid-template-columns:repeat(2,1fr)}}
.kpi{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:14px 15px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.kpi::after{content:"";position:absolute;left:0;top:0;height:100%;width:3px;background:var(--gold)}
.kpi .k{font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-soft);font-weight:700;display:flex;align-items:center;gap:5px}
.kpi .v{font-family:'Playfair Display';font-size:23px;font-weight:600;margin-top:5px;letter-spacing:-.02em}
.kpi .v.pos{color:var(--ok)}.kpi .v.neg{color:var(--madder)}
.kpi .meta{font-size:11px;color:var(--ink-soft);margin-top:2px}
.kpi .tip{cursor:help;font-size:10px;color:var(--ink-soft);border:1px solid var(--line);border-radius:50%;width:14px;height:14px;display:inline-grid;place-items:center;line-height:1}
.band-h{font-family:'Playfair Display';font-weight:600;font-size:14px;color:var(--ink-soft);margin:2px 0 10px;letter-spacing:.02em}

/* Image capture */
.img-cap{display:flex;gap:14px;align-items:center}
.img-prev{width:88px;height:88px;border-radius:14px;border:1px dashed var(--line);background:var(--cream);display:grid;place-items:center;overflow:hidden;flex:0 0 88px;font-size:10.5px;color:var(--ink-soft);text-align:center;padding:4px}
.img-prev img{width:100%;height:100%;object-fit:cover;border-radius:13px}
.img-btns{display:flex;flex-direction:column;gap:8px}
.img-btns label,.img-btns button{margin:0}
.sku-thumb{width:42px;height:42px;border-radius:9px;object-fit:cover;border:1px solid var(--line);display:block}
.sku-thumb-ph{width:42px;height:42px;border-radius:9px;border:1px dashed var(--line);display:grid;place-items:center;font-size:15px;color:var(--ink-soft);background:var(--cream)}
.tpl-box{background:var(--cream);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-family:monospace;font-size:11.5px;color:var(--ink-soft);overflow-x:auto;white-space:pre;margin-bottom:4px}

/* Mobile polish */
@media(max-width:640px){
  .app{padding:0 11px 120px}
  h2.title{font-size:23px}
  nav.tabs button{padding:9px 11px;font-size:12.5px}
  .modal-b{padding:16px 15px 20px}
  .modal-h{padding:15px 16px 12px}
  .modal-f{padding:12px 15px}
  input,select,textarea{font-size:16px} /* prevents iOS zoom-on-focus */
  .entry{padding:15px 13px}
  .btn{padding:12px 16px}
  .img-prev{width:76px;height:76px;flex-basis:76px}
}
</style>
</head>
<body>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="side-brand">
      <div class="mark"><img src="data:image/png;base64," alt="Kritivan"></div>
      <div class="sub">D2C Tracker</div>
    </div>
    <nav class="side-nav" id="sideNav">
      <button data-screen="dashboard" data-title="Business Overview" class="active"><span class="ni">📊</span> Overview</button>
      <button data-screen="home" data-title="Add Data"><span class="ni">➕</span> Add Data</button>
      <button data-screen="demand" data-title="Demand · Online vs Offline"><span class="ni">📈</span> Demand</button>
      <button data-screen="social" data-title="Social"><span class="ni">📱</span> Social</button>
      <button data-screen="skus" data-title="Catalog"><span class="ni">🏷️</span> Catalog</button>
      <div class="nav-div">SETTINGS</div>
      <button data-screen="settings" data-title="Settings &amp; Sync"><span class="ni">⚙️</span> Settings &amp; Sync</button>
    </nav>
    <div class="side-foot">
      <button class="btn primary side-cta" onclick="goAdd()">➕ New entry</button>
      <div class="saved-pill" id="savePill"><span class="dot"></span> Saved</div>
    </div>
  </aside>
  <div class="backdrop" id="backdrop" onclick="toggleNav(false)"></div>

  <main class="main">
    <header class="topbar">
      <button class="hamb" onclick="toggleNav(true)" aria-label="Menu">☰</button>
      <h2 class="page-title" id="pageTitle">Business Overview</h2>
      <div class="topbar-actions">
        <span class="sync-dot" id="syncDot" title="Local only"></span>
        <button class="btn primary sm" onclick="goAdd()">➕ New entry</button>
      </div>
    </header>
    <div class="content">
  <!-- HOME -->
  <section class="screen" id="home">
    <h2 class="title">Add Data</h2>
