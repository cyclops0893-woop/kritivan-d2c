        <label class="btn ghost sm">🖼️ Gallery<input type="file" accept="image/*" hidden onchange="grabImg(this,'${id}')"></label>
        <button type="button" class="btn ghost sm" onclick="clearImg('${id}')">Remove</button>
      </div>
    </div></div>`;
}
function grabImg(input,id){
  const f=input.files&&input.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=ev=>{
    const im=new Image();
    im.onload=()=>{
      const max = id.indexOf('rcpt')===0 ? 700 : 460;
      let w=im.width,h=im.height; const sc=Math.min(1,max/Math.max(w,h));
      w=Math.round(w*sc); h=Math.round(h*sc);
      const c=document.createElement('canvas'); c.width=w; c.height=h;
      c.getContext('2d').drawImage(im,0,0,w,h);
      const q = id.indexOf('rcpt')===0 ? 0.55 : 0.62;
      const data=c.toDataURL('image/jpeg',q);
      formExtra.img=formExtra.img||{}; formExtra.img[id]=data;
      const p=document.getElementById(id+'_prev'); if(p) p.innerHTML=`<img src="${data}">`;
    };
    im.src=ev.target.result;
  };
  r.readAsDataURL(f);
}
function clearImg(id){ formExtra.img=formExtra.img||{}; formExtra.img[id]=''; const p=document.getElementById(id+'_prev'); if(p) p.innerHTML='Tap to add'; }
function getImg(id,fallback){ return (formExtra.img&&formExtra.img[id]!==undefined)?formExtra.img[id]:(fallback||''); }

