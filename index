/* ---------- Shared CSV + image + bulk helpers ---------- */
function splitCSV(l){ const out=[];let cur='',q=false;for(let i=0;i<l.length;i++){const ch=l[i];if(ch==='"'){q=!q;}else if(ch===','&&!q){out.push(cur);cur='';}else cur+=ch;}out.push(cur);return out.map(s=>s.trim()); }
function csvToObjects(text){
  const lines=(text||'').trim().split(/\r?\n/).filter(l=>l.trim()); if(lines.length<2) return [];
  const head=splitCSV(lines[0]).map(h=>h.trim().toLowerCase());
  const out=[];
  for(let i=1;i<lines.length;i++){ const c=splitCSV(lines[i]); const o={}; head.forEach((h,j)=>o[h]=(c[j]||'').trim()); out.push(o); }
  return out;
}

/* image capture (camera or gallery), resized + compressed before storing */
function captureBlock(id,label,current){
  return `<div class="fg"><label>${label} <span class="opt">(optional)</span></label>
    <div class="img-cap">
      <div class="img-prev" id="${id}_prev">${current?`<img src="${current}">`:'Tap to add'}</div>
