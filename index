<script>
/* ============================================================
   KRITIVAN D2C TRACKER — persistent single-file app
   Storage: window.storage (artifact DB) with in-memory fallback
   ============================================================ */
const KEY = 'kritivan_v1';

/* ===== Supabase cloud config =====
   1. Paste your project URL below (or set it in Settings ▸ Cloud database).
   2. Run the SQL in supabase-setup.sql once, in your Supabase SQL editor.
   The publishable key is safe to ship in client-side code. */
const SUPABASE_URL_DEFAULT = 'https://YOUR-PROJECT-REF.supabase.co'; // ← replace with your project URL
const SUPABASE_KEY = 'sb_publishable_cGvHfMHEIN_73QbqHq-50g_C1-LLzVC';
const SB_TABLE = 'kritivan_state';
const SB_WORKSPACE = 'kritivan-main';   // row id — change to run multiple workspaces
let sb = null, SB_URL = '';

const hasStore = (()=>{ try { return !!(window.storage && window.storage.get); } catch(e){ return false; } })();

const uid = ()=> Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const inr = n => '₹'+Math.round(n||0).toLocaleString('en-IN');
const num = n => (n||0).toLocaleString('en-IN');
const todayISO = ()=> new Date().toISOString().slice(0,10);

/* ---------- Seed SKUs (12) ---------- */
function seedSkus(){
  const mk=(code,cat,design,size,mrp,cost,wt,dims,overlap,offline)=>({
    id:uid(),code,cat,design,size,mrp,cost,weight:wt,dims,overlap,offline
  });
  return [
    mk('BC-A-S','Bedcover','Design A','Single',2499,1100,800,'30x25x6',true ,'OFF-BC-A-S'),
    mk('BC-A-D','Bedcover','Design A','Double',3299,1450,1100,'34x28x7',true ,'OFF-BC-A-D'),
    mk('BC-B-S','Bedcover','Design B','Single',2499,1100,800,'30x25x6',true ,'OFF-BC-B-S'),
    mk('BC-B-D','Bedcover','Design B','Double',3299,1450,1100,'34x28x7',true ,'OFF-BC-B-D'),
    mk('BS-A','Bedsheet','Design A','One size',1799,780,650,'30x24x5',true ,'OFF-BS-A'),
    mk('BS-B','Bedsheet','Design B','One size',1799,780,650,'30x24x5',true ,'OFF-BS-B'),
    mk('BS-C','Bedsheet','Design C','One size',1799,780,650,'30x24x5',false,'OFF-BS-C'),
    mk('BS-D','Bedsheet','Design D','One size',1799,780,650,'30x24x5',false,'OFF-BS-D'),
    mk('DH-A-S','Dohar','Design A','Single',2199,950,900,'32x26x8',false,'OFF-DH-A-S'),
    mk('DH-A-D','Dohar','Design A','Double',2899,1250,1300,'36x30x9',false,'OFF-DH-A-D'),
    mk('DH-B-S','Dohar','Design B','Single',2199,950,900,'32x26x8',false,'OFF-DH-B-S'),
    mk('DH-B-D','Dohar','Design B','Double',2899,1250,1300,'36x30x9',false,'OFF-DH-B-D'),
  ];
}
function blank(){
  return { skus:seedSkus(), inventory:[], logistics:[], shoots:[], gst:[],
    marketing:[], shopify:[], salesImports:[], shipping:[], events:[], instagram:[], influencers:[], other:[],
    syncUrl:'', autoPush:false };
}
let state = blank();

/* ---------- Persistence ---------- */
async function load(){
  if(hasStore){
    try{ const r = await window.storage.get(KEY); if(r&&r.value){ state = Object.assign(blank(), JSON.parse(r.value)); } }
    catch(e){ /* first run / not found */ }
  } else {
    try{ const m = sessionStorage.getItem(KEY); if(m) state = Object.assign(blank(), JSON.parse(m)); }catch(e){}
  }
}
let saveTimer;
function save(){
  flashSaved();
  clearTimeout(saveTimer);
  saveTimer = setTimeout(async ()=>{
    const payload = JSON.stringify(state);
    if(hasStore){ try{ await window.storage.set(KEY, payload); }catch(e){ try{sessionStorage.setItem(KEY,payload);}catch(_){}} }
    else { try{ sessionStorage.setItem(KEY,payload); }catch(e){} }
    cloudSave();           // mirror to Supabase when configured
    if(state.autoPush && state.syncUrl) pushSheet(true); // optional Sheets mirror
  },150);
}
function flashSaved(){ const p=document.getElementById('savePill'); p.style.opacity='.4'; setTimeout(()=>p.style.opacity='1',300); }

/* ---------- Supabase cloud database ---------- */
function sbConfigured(){ return !!sb; }
function initSupabase(){
  try{ SB_URL = (localStorage.getItem('kritivan_sb_url')||'').trim() || SUPABASE_URL_DEFAULT; }
  catch(e){ SB_URL = SUPABASE_URL_DEFAULT; }
  const valid = SB_URL && SB_URL.indexOf('http')===0 && SB_URL.indexOf('YOUR-PROJECT')<0;
  if(valid && window.supabase && window.supabase.createClient){
    try{ sb = window.supabase.createClient(SB_URL, SUPABASE_KEY); }catch(e){ sb=null; }
  }
}
async function cloudLoad(){
  if(!sb) return null;
  try{
    const { data, error } = await sb.from(SB_TABLE).select('data').eq('id', SB_WORKSPACE).maybeSingle();
    if(error){ console.warn('cloudLoad', error.message); return null; }
    return data ? data.data : null;
  }catch(e){ console.warn('cloudLoad', e); return null; }
}
let cloudTimer;
function cloudSave(){
  if(!sb) return;
  clearTimeout(cloudTimer);
  cloudTimer = setTimeout(async ()=>{
    try{
      const { error } = await sb.from(SB_TABLE)
        .upsert({ id: SB_WORKSPACE, data: state, updated_at: new Date().toISOString() });
      if(error) console.warn('cloudSave', error.message);
    }catch(e){ console.warn('cloudSave', e); }
  }, 400);
}

/* ---------- Helpers ---------- */
const catClass = c => c==='Bedcover'?'bc':c==='Bedsheet'?'bs':'dh';
function skuByCode(code){ return state.skus.find(s=>s.code===code); }
function skuLabel(s){ return s.code+' · '+s.design+(s.size&&s.size!=='One size'?' '+s.size:''); }

