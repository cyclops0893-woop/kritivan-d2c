/* ============================================================
   AGGREGATIONS
   ============================================================ */
function computeSku(){
  const m={};
  state.skus.forEach(s=>m[s.code]={code:s.code,cat:s.cat,design:s.design,size:s.size,mrp:s.mrp,cost:s.cost,
    purch:0,invCost:0,freight:0,shoot:0,mkt:0,onlineU:0,onlineR:0,offU:0,offR:0});
  state.inventory.forEach(r=>{const x=m[r.sku];if(!x)return;x.purch+=r.qty;x.invCost+=r.qty*r.unit*(1+r.gst/100);x.freight+=r.freight||0;});
  state.shoots.forEach(sh=>sh.skus.forEach(c=>{if(m[c])m[c].shoot+=sh.perSku;}));
  state.marketing.forEach(r=>{if(r.sku&&m[r.sku])m[r.sku].mkt+=r.spend;});
  state.shopify.forEach(r=>{const x=m[r.sku];if(!x)return;x.onlineU+=r.qty;x.onlineR+=r.qty*r.price;});
  state.events.forEach(ev=>ev.lines.forEach(l=>{const x=m[l.sku];if(!x)return;x.offU+=l.sold;x.offR+=l.sold*l.price;}));
  Object.values(m).forEach(x=>{
    x.soldU=x.onlineU+x.offU; x.rev=x.onlineR+x.offR;
    x.landed = x.purch? (x.invCost+x.freight+x.shoot)/x.purch : (x.cost||0);
    x.cogs = x.landed*x.soldU;
    x.margin = x.rev - x.cogs - x.mkt;
    x.totalSpend = x.invCost + x.freight + x.shoot + x.mkt;
  });
  return m;
}
function totals(){
  const inv=state.inventory.reduce((a,r)=>a+r.qty*r.unit*(1+r.gst/100),0);
  const freight=state.inventory.reduce((a,r)=>a+(r.freight||0),0)+state.logistics.reduce((a,r)=>a+r.cost,0);
  const shoot=state.shoots.reduce((a,r)=>a+r.cost,0);
  const mkt=state.marketing.reduce((a,r)=>a+r.spend,0);
  const infl=state.influencers.reduce((a,r)=>a+(r.productCost||0)+(r.fee||0),0);
  const events=state.events.reduce((a,e)=>a+(e.stall||0)+(e.travel||0)+(e.setup||0),0);
  const other=state.other.reduce((a,r)=>a+r.amount,0);
  const shipNet=state.shipping.reduce((a,r)=>a+(r.charged-r.actual),0);
  const onlineR=state.shopify.reduce((a,r)=>a+r.qty*r.price,0);
  const offR=state.events.reduce((a,e)=>a+e.lines.reduce((b,l)=>b+l.sold*l.price,0),0);
  const totalSpend=inv+freight+shoot+mkt+infl+events+other;
  const revenue=onlineR+offR;
  return {inv,freight,shoot,mkt,infl,events,other,shipNet,onlineR,offR,totalSpend,revenue,net:revenue-totalSpend+shipNet};
}

/* ============================================================
   RENDERERS
   ============================================================ */
function computeKPIs(){
  const t=totals(); const m=computeSku(); const econ=Object.values(m);
  const unitsSold=econ.reduce((a,x)=>a+x.soldU,0);
  const unitsBought=econ.reduce((a,x)=>a+x.purch,0);
  const cogs=econ.reduce((a,x)=>a+x.cogs,0);
  const adSpend=t.mkt+t.infl;
  const ordersOnline=(state.salesImports||[]).reduce((a,r)=>a+(r.orders||0),0);
  const ordersOffline=state.events.reduce((a,e)=>a+(e.bills||0),0);
  const orders=ordersOnline+ordersOffline;
  const shipLoss=t.shipNet<0?-t.shipNet:0;
  return {
    revenue:t.revenue, orders, unitsSold, unitsBought,
    grossMargin: t.revenue? (t.revenue-cogs)/t.revenue*100 : 0,
    contribution: t.revenue - cogs - adSpend - shipLoss,
    roas: adSpend? t.revenue/adSpend : 0,
    cac: orders? adSpend/orders : 0,
    aov: orders? t.revenue/orders : 0,
    sellThrough: unitsBought? unitsSold/unitsBought*100 : 0,
    inStock: unitsBought-unitsSold,
    mer: t.revenue? adSpend/t.revenue*100 : 0,
    adSpend
  };
}
