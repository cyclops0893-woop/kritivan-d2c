function bulkSave(){
  const target=val('b_target'); const rows=csvToObjects(val('b_csv')); let n=0;
  rows.forEach(o=>{
    if(target==='inventory'){
      if(!o.sku||!(+o.units)) return;
      state.inventory.push({id:uid(),date:o.date||todayISO(),supplier:o.supplier||'',sku:(o.sku||'').toUpperCase(),
        qty:+o.units||0,unit:+o.unitcost||0,gst:+o.gst||0,freight:+o.freight||0,notes:'bulk import'}); n++;
    } else if(target==='marketing'){
      if(!(+o.spend)) return;
      state.marketing.push({id:uid(),date:o.date||todayISO(),platform:o.platform||'Other',campaign:o.campaign||'',
        sku:(o.sku||'').toUpperCase(),spend:+o.spend||0,impr:+o.impressions||0,orders:+o.orders||0}); n++;
    } else if(target==='other'){
      if(!(+o.amount)) return;
      state.other.push({id:uid(),date:o.date||todayISO(),category:o.category||'Misc',vendor:o.vendor||'',
        amount:+o.amount||0,notes:o.notes||'bulk import'}); n++;
    }
  });
  if(!n){ return toast('No valid rows found — check the columns'); }
  toast(`Imported ${n} row(s) ✓`); finishSave();
}

/* ---------- Misc UI ---------- */
function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),1900); }
function renderAll(){ renderDashboard(); renderDemand(); renderSocial(); renderSkus(); updateSyncUI(); }

/* ---------- Navigation (sidebar shell) ---------- */
function navigate(screen){
  const btn=document.querySelector('#sideNav button[data-screen="'+screen+'"]');
  document.querySelectorAll('#sideNav button').forEach(x=>x.classList.remove('active'));
  if(btn){ btn.classList.add('active'); document.getElementById('pageTitle').innerHTML=btn.dataset.title; }
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const el=document.getElementById(screen); if(el) el.classList.add('active');
  toggleNav(false);
  window.scrollTo(0,0);
}
function toggleNav(open){
  document.getElementById('sidebar').classList.toggle('open',open);
  document.getElementById('backdrop').classList.toggle('show',open);
}
function goAdd(){ navigate('home'); }
function updateSyncUI(){
  const cloud=sbConfigured(), sheets=!!state.syncUrl, on=cloud||sheets;
  const dot=document.getElementById('syncDot');
  if(dot){ dot.classList.toggle('on',on); dot.title=cloud?'Supabase connected':(sheets?'Google Sheets connected':'Local only'); }
  const hint=document.getElementById('syncHint'); if(hint) hint.textContent=sheets?'Connected ✓':'Not connected';
  const sbHint=document.getElementById('sbHint'); if(sbHint) sbHint.textContent=cloud?'Connected ✓':'Not configured';
  const sbInput=document.getElementById('sb_url'); if(sbInput && !sbInput.value){ try{ sbInput.value=localStorage.getItem('kritivan_sb_url')||''; }catch(e){} }
}
async function saveSbUrl(){
  const url=val('sb_url').trim();
  if(url && url.indexOf('http')!==0){ return toast('URL should start with https://'); }
  try{ localStorage.setItem('kritivan_sb_url', url); }catch(e){}
  initSupabase();
  if(!sbConfigured()){ updateSyncUI(); return toast(url?'Could not connect — check the URL':'Cleared'); }
  toast('Connecting & loading…');
  const cloud=await cloudLoad();
  if(cloud && Object.keys(cloud).length){ state=Object.assign(blank(), cloud); toast('Connected — loaded cloud data ✓'); }
  else { await cloudSaveNow(); toast('Connected — cloud started from this device ✓'); }
  updateSyncUI(); renderAll();
}
async function cloudSaveNow(){
  if(!sb) return;
  try{ await sb.from(SB_TABLE).upsert({ id:SB_WORKSPACE, data:state, updated_at:new Date().toISOString() }); }
  catch(e){ console.warn(e); }
}
async function cloudPush(){
  if(!sbConfigured()){ return toast('Connect a Supabase URL first'); }
  await cloudSaveNow(); toast('Saved to cloud ✓');
}
async function cloudPull(){
  if(!sbConfigured()){ return toast('Connect a Supabase URL first'); }
  const cloud=await cloudLoad();
  if(cloud && Object.keys(cloud).length){ state=Object.assign(blank(), cloud); save(); renderAll(); toast('Loaded from cloud ✓'); }
  else toast('No cloud data yet');
}
function resetData(){
  if(!confirm('Reset ALL data on this device? This restores the starting 12 SKUs and cannot be undone. Export or push to Sheets first.')) return;
  const url=state.syncUrl, auto=state.autoPush;
  state=blank(); state.syncUrl=url; state.autoPush=auto;
  save(); renderAll(); navigate('dashboard'); toast('Workspace reset');
}
document.getElementById('sideNav').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b) return; navigate(b.dataset.screen);
});

/* ---------- Boot ---------- */
(async function init(){
  await load();
  try{ if(!state.syncUrl){ const u=localStorage.getItem('kritivan_syncurl'); if(u) state.syncUrl=u; } }catch(e){}
  initSupabase();
  if(sbConfigured()){
    const cloud = await cloudLoad();
    if(cloud && Object.keys(cloud).length){
      state = Object.assign(blank(), cloud);     // cloud is the source of truth
    } else if(!isEmptyData()){
      cloudSave();                               // first run: seed cloud from local
    }
  }
  renderHome();
  renderAll();
  if(!sbConfigured() && state.syncUrl && isEmptyData()) pullSheet(); // fall back to Sheets only if no Supabase
})();
</script>
