  document.getElementById('modal').scrollTop=0;
}
function closeModal(){ document.getElementById('overlay').classList.remove('show'); currentForm=null; formExtra={}; }
document.getElementById('overlay').addEventListener('click',e=>{ if(e.target.id==='overlay') closeModal(); });

const skuOptions = (sel)=> state.skus.map(s=>`<option value="${s.code}" ${sel===s.code?'selected':''}>${skuLabel(s)}</option>`).join('');

