/* ---------- Live calculators ---------- */
function val(id){ const e=document.getElementById(id); return e?e.value:''; }
function fnum(id){ return parseFloat(val(id))||0; }
function toggleChk(l){ /* whole-label click handled by checkbox */ }

function invCalc(){
  const q=fnum('f_qty'),u=fnum('f_unit'),g=fnum('f_gst'),f=fnum('f_freight');
  if(!q){document.getElementById('invOut').innerHTML='';return;}
  const base=q*u, gst=base*g/100, landed=(base+gst+f)/q;
  document.getElementById('invOut').innerHTML=`<div class="calc-pill">Total ${inr(base+gst+f)} · Landed cost / unit ${inr(landed)}</div>`;
}
function shootCalc(){
  const c=fnum('f_cost'); const n=document.querySelectorAll('#modalBody .checklist input:checked').length;
  document.getElementById('shootOut').innerHTML = (c&&n)?`<div class="calc-pill">${inr(c/n)} allocated to each of ${n} SKU(s)</div>`:'';
}
function shipWt(){ const s=skuByCode(val('f_sku')); if(s&&!val('f_wt')){ /* hint only */ } }
function shipCalc(){
  const wt=fnum('f_wt'),rate=fnum('f_rate'),charged=fnum('f_charged');
  let actual=fnum('f_actual'); if(!actual&&wt&&rate) actual=wt*rate;
  const diff=charged-actual;
  document.getElementById('shipOut').innerHTML = (charged||actual)?`<div class="calc-pill" style="background:${diff>=0?'rgba(63,125,87,.12)':'rgba(184,80,58,.14)'};color:${diff>=0?'var(--ok)':'var(--madder)'}">Actual cost ${inr(actual)} · You ${diff>=0?'keep':'lose'} ${inr(Math.abs(diff))} on this shipment</div>`:'';
}
function offCalc(){
  let rev=0,sold=0;
  document.querySelectorAll('#modalBody [data-f="sold"]').forEach(inp=>{
    const code=inp.dataset.sku, s=parseFloat(inp.value)||0;
    const priceEl=document.querySelector(`#modalBody [data-sku="${code}"][data-f="price"]`);
    const sku=skuByCode(code); const price=parseFloat(priceEl.value)|| (sku?sku.mrp:0);
    rev+=s*price; sold+=s;
  });
  document.getElementById('offOut').innerHTML = sold?`<div class="calc-pill">${sold} units sold · ${inr(rev)} revenue</div>`:'';
}
function inflCalc(){
  let pc=0,n=0;
  document.querySelectorAll('#modalBody .checklist input:checked').forEach(c=>{pc+=parseFloat(c.dataset.cost)||0;n++;});
  const fee=fnum('f_fee'), orders=fnum('f_orders'); const total=pc+fee;
  let html=`<div class="calc-pill">Total cost ${inr(total)} (product ${inr(pc)} + fee ${inr(fee)})`;
  if(orders) html+=` · ${inr(total/orders)} per order`;
  html+='</div>';
  document.getElementById('inflOut').innerHTML = (n||fee)?html:'';
}
function parseCSV(text){
  const lines=text.trim().split(/\r?\n/).filter(l=>l.trim()); if(!lines.length) return [];
  const head=splitCSV(lines[0]).map(h=>h.toLowerCase());
  const iSku=head.findIndex(h=>h.includes('sku'));
  const iQty=head.findIndex(h=>h.includes('quantity'));
  const iPrice=head.findIndex(h=>h.includes('price'));
  const iName=head.findIndex(h=>h==='name'||h.includes('order id')||h.includes('order number'));
  const rows=[];
  for(let i=1;i<lines.length;i++){
    const c=splitCSV(lines[i]);
    const sku=iSku>=0?c[iSku]:c[0];
    const qty=parseFloat(iQty>=0?c[iQty]:c[1])||0;
    const price=parseFloat(iPrice>=0?c[iPrice]:c[2])||0;
    const order=iName>=0?c[iName]:'';
    if(sku&&qty) rows.push({sku,qty,price,order});
  }
  return rows;
}
function distinctOrders(rows){ const s=new Set(); rows.forEach(r=>{ if(r.order) s.add(r.order); }); return s.size; }
function csvPreview(){
  const rows=parseCSV(val('f_csv'));
  const agg={};let units=0,rev=0,unknown=0;
  rows.forEach(r=>{ agg[r.sku]=(agg[r.sku]||0)+r.qty; units+=r.qty; rev+=r.qty*r.price; if(!skuByCode(r.sku)) unknown+=r.qty; });
  formExtra.csvRows=rows;
  const ord=distinctOrders(rows);
  document.getElementById('csvOut').innerHTML = rows.length?
    `<div class="calc-pill">${rows.length} line items${ord?` · ${ord} orders`:''} · ${units} units · ${inr(rev)} revenue${unknown?` · ⚠ ${unknown} units have SKUs not in your master`:''}</div>`:'';
}

